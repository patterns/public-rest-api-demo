{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"],
      "@base/*": ["src/*"],
      "@api/*": ["src/api/*"]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "typeRoots": ["@types", "./node_modules/@types"]
  },
  "include": ["src/**/*", "service/auth-service.ts", "src/testdata"],
}